# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it's already in .gitignore.

# Your live site address (no trailing slash). Paystack sends customers back here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number for the chat bubble and "Order on WhatsApp" buttons.
# International format, digits only — e.g. 2348012345678
NEXT_PUBLIC_WHATSAPP_NUMBER=2340000000000

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The *service_role* key (secret). Server-only — never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack → Settings → API Keys & Webhooks
# Use sk_test_... while testing, then switch to sk_live_... to go live.
PAYSTACK_SECRET_KEY=

# ── Admin area (/admin) ──
# Choose a long password only you know. Changing it logs out every device.
ADMIN_PASSWORD=

# ── Owner notifications (each one is optional) ──
# EMAIL via Resend (https://resend.com → API Keys). Without your own verified
# domain, OWNER_EMAIL must be the same email you signed up to Resend with.
RESEND_API_KEY=
OWNER_EMAIL=
# Sender address. Only set this AFTER your domain shows "Verified" in Resend.
# Setting it also switches on confirmation emails to customers.
EMAIL_FROM="Rabbit Land <orders@rabbitlandfarms.com>"
# Where customers' replies go (defaults to OWNER_EMAIL)
# EMAIL_REPLY_TO=hello@rabbitlandfarms.com

# Optional: use templates you've created in Resend → Templates (ID or alias).
# Leave empty to use the built-in designs.
RESEND_TEMPLATE_ORDER=
RESEND_TEMPLATE_TRAINING=

# WHATSAPP via CallMeBot (optional, leave empty to turn off). Setup in README.
CALLMEBOT_PHONE=+234XXXXXXXXXX
CALLMEBOT_APIKEY=
