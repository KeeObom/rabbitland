# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it's already in .gitignore.

# Your live site address (no trailing slash). Paystack sends customers back here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number for the chat bubble and "Order on WhatsApp" buttons.
# International format, digits only — e.g. 2348012345678
NEXT_PUBLIC_WHATSAPP_NUMBER=2340000000000

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The *service_role* key (secret). Server-only — never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack → Settings → API Keys & Webhooks
# Use sk_test_... while testing, then switch to sk_live_... to go live.
PAYSTACK_SECRET_KEY=
